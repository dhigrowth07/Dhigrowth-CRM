# ==============================================================================
# WAP PILOT / DhiGrowth CRM - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required)
# ------------------------------------------------------------------------------
# Get from: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Direct Database Connection String (Supabase -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Meta WhatsApp Cloud API (Required for WhatsApp Messaging)
# ------------------------------------------------------------------------------
# Get from: https://developers.facebook.com -> WhatsApp -> API Setup
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_WABA_ID=your_whatsapp_business_account_id
META_WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token

# Secret string you set in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
META_WHATSAPP_VERIFY_TOKEN=dhigrowth_webhook_secret_2026

# Optional: Instagram Messaging Access Token
META_INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_token

# ------------------------------------------------------------------------------
# 3. Application & Deployment Routing
# ------------------------------------------------------------------------------
# Default Workspace Partition ID (UUID format)
VITE_DEFAULT_WORKSPACE_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb

# Public URL of your Render Backend Web Service (No trailing slash)
# e.g., https://wapppilot-backend.onrender.com
VITE_BACKEND_URL=https://api-wappilot.dhigrowth.com

# Node server port (Render automatically sets PORT in production)
PORT=4000

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Engine (For AI Business Studio & Smart Auto-Reply)
# ------------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Razorpay Payments (For Wallet Recharges & Invoicing)
# ------------------------------------------------------------------------------
# Get from: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
