# ==============================================================================
# DHIGROWTH CRM / WAP PILOT — MODULAR BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database & Auth (Required)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Optional Direct PostgreSQL Connection String for migrations:
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Default Multi-Tenant Workspace UUID:
DEFAULT_WORKSPACE_ID=b0000000-0000-0000-0000-000000000001

# ------------------------------------------------------------------------------
# 3. Meta WhatsApp Cloud API & Omnichannel (Required for live messaging)
# ------------------------------------------------------------------------------
# Obtain from: https://developers.facebook.com -> WhatsApp -> API Setup
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_WABA_ID=your_whatsapp_business_account_id
META_WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token

# Secret token configured in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
META_WHATSAPP_VERIFY_TOKEN=dhigrowth_webhook_secret_2026

# Meta Embedded Signup & OAuth App Configuration:
META_APP_ID=1611291237194962
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_meta_config_id

# Optional: Instagram DM & Messenger Access Tokens
META_INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_token
META_INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_MESSENGER_ACCESS_TOKEN=your_messenger_access_token

# ------------------------------------------------------------------------------
# 4. Multi-LLM Autonomous AI Engine (Gemini / Groq / OpenAI / DeepSeek)
# ------------------------------------------------------------------------------
# Google Gemini (Primary provider - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Groq High-Speed Inference (Secondary provider - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI Adapter (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek Adapter (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ------------------------------------------------------------------------------
# 5. Razorpay Payments (For AI Credits Recharge & Wallet Top-ups)
# ------------------------------------------------------------------------------
# Obtain from: https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ------------------------------------------------------------------------------
# 6. Integrations & Pipelines
# ------------------------------------------------------------------------------
# Google Apps Script Webhook URL for lead synchronization:
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
